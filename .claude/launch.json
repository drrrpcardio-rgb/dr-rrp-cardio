{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dr-rrp-cardio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "ecg-simulator",
      "runtimeExecutable": "node",
      "runtimeArgs": ["D:/ecg-simulator/node_modules/vite/bin/vite.js", "D:/ecg-simulator", "--config", "D:/ecg-simulator/vite.config.ts", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "coronary-angiography",
      "runtimeExecutable": "node",
      "runtimeArgs": ["D:/coronary-angiography/node_modules/vite/bin/vite.js", "D:/coronary-angiography", "--port", "3002"],
      "port": 3002
    },
    {
      "name": "coronary-angiography-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["D:/coronary-angiography/node_modules/vite/bin/vite.js", "preview", "D:/coronary-angiography", "--port", "3003", "--strictPort"],
      "port": 3003
    }
  ]
}
